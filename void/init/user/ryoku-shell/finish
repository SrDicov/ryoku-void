#!/bin/sh
# runsv passes -1 for a requested down; crashes must not run prepare-stop.
exec 2>&1

BIN=${RYOKU_BIN_DIR:-/usr/bin}
_status=$1

# Bounded: a lock held by a stuck peer must not freeze the supervisor.
timeout 20 "$BIN/ryoku-power-cutover" qylock-guards-stop >/dev/null 2>&1 || true

if [ "$_status" -eq -1 ]; then
	# Bounded: waiting for a locked screen to unlock is not this process's job
	# and used to hang the supervisor's finish forever.
	timeout 30 "$BIN/ryoku-qylock-activate" --prepare-stop || true
fi

exit 1
